# Copy to .env.local for authenticated multiplayer.
# Without these, the app runs in Local Demo mode (browser localStorage only).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for /api/game command persistence (never expose to the browser):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: force demo even when Supabase env is present
# NEXT_PUBLIC_FORCE_DEMO=true
